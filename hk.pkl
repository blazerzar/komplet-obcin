amends "package://github.com/jdx/hk/releases/download/v2.3.0/hk@2.3.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.3.0/hk@2.3.0#/Builtins.pkl"

local linters = new Mapping {
  ["mixed-lined-ending"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["ruff"] = Builtins.ruff
  ["ruff_format"] = (Builtins.ruff_format) {
    depends = "ruff"
  }
  ["taplo"] = Builtins.taplo
  ["taplo-format"] = (Builtins.taplo_format) {
    depends = "taplo"
  }
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = (Builtins.pkl_format) {
    depends = "pkl"
  }
  ["rumdl"] = Builtins.rumdl
  ["rumdl-format"] = (Builtins.rumdl_format) {
    depends = "rumdl"
  }
  ["yamllint"] = Builtins.yamllint
  ["yamlfmt"] = (Builtins.yamlfmt) {
    depends = "yamllint"
  }
}

steps = linters
